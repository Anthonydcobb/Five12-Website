# Copy this file to an untracked `.env` file and fill in local values.
# Never commit real passwords, tokens, linking keys, or production credentials.
#
# On the Windows rig the app is launched by start.ps1, which runs the backend
# from `backend/`, so the file that actually gets read is `backend/.env`.
# `flask run` loads it automatically (python-dotenv); there is no load_dotenv()
# call in config.py, which is why a key can be live without appearing there.

# Development MySQL database (not used by desktop SQLite mode)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=five12_website

# Optional mail settings retained for legacy/mail-enabled workflows
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Feature gates
#
# Every gate that touches hardware defaults OFF, so a hosted or unattended
# deploy never drives a radio, a console or a tablet unasked. On the show rig
# the opposite is true: launching Five12 IS the ask. A gate left at its default
# does not fail loudly — the feature simply reports itself disabled and names
# the variable, so an undocumented gate reads as a broken feature.
# ---------------------------------------------------------------------------

# Bluetooth / Cintenna (CRMX). TOOLS enables passive discovery and connected
# status reads; WRITE additionally enables mode switch, Link and Unlink.
# start.ps1 sets BOTH to 1 for the backend it spawns, so on the rig these are
# already on and setting them here is only needed for other launch paths.
# Default: 0 (off).
FIVE12_BLE_TOOLS=0
FIVE12_BLE_WRITE=0

# Astera tablet mirror. Executes adb as a subprocess, so it is gated.
# start.ps1 does NOT set this — without it the Devices tab shows the Astera
# panel reporting "tablet mirror disabled". Default: 0 (off).
FIVE12_MIRROR_TOOLS=0
# adb serial of the mirror tablet, from `adb devices`. Never taken from request
# input — a request cannot name a target device. Default: unset (no device).
FIVE12_MIRROR_SERIAL=
# Path to the adb binary. Default: 'adb' from PATH. Set this if adb is not on
# PATH — e.g. the copy bundled with scrcpy.
FIVE12_ADB_PATH=

# Network tools (interface enumeration, route inspection).
# Default: 1 (ON) — read-only and safe.
FIVE12_NETWORK_TOOLS=1

# Device adapter simulation. Accepts '1' or 'true'. Adapters that declare
# supports_sim = False ignore it and say so rather than silently driving real
# hardware. Default: unset (off).
FIVE12_DEVICE_SIM=

# sACN universes to join, overriding the default baseline of 1-16.
# Format: "1-32" or "1-16,101-104". Malformed parts are ignored rather than
# failing startup. Set empty to restore pure discovery-driven joins.
FIVE12_SACN_UNIVERSES=

# Riedel Bolero. Host unset means the adapter reports not-configured rather
# than probing. Credential defaults are the appliance's factory values —
# override them here rather than in code, and do not commit real ones.
FIVE12_BOLERO_HOST=
FIVE12_BOLERO_USER=user
FIVE12_BOLERO_PASS=

# LumenRadio Stardust. Unset means not configured.
FIVE12_STARDUST_HOST=
