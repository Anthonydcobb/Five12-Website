# Copy this file to an untracked `.env` file and fill in local values.
# Never commit real passwords, tokens, linking keys, or production credentials.

# Development MySQL database (not used by desktop SQLite mode)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=five12_website

# Optional mail settings retained for legacy/mail-enabled workflows
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
