# 🛑 Python Virtual Environment
venv/
.venv/
.env

# 🛑 Compiled Python files
__pycache__/
*.pyc
*.pyo
*.pyd

# 🛑 IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo

# 🛑 Flask & Database
instance/
# Anchored so this ignores ONLY the dead root-level migrations/ copy. The live
# Alembic history is backend/migrations/ — a bare `migrations/` matched that too
# and silently kept every real migration out of git.
/migrations/
*.sqlite3
*.db

# 🛑 Log and Cache Files
*.log
*.cache

# 🛑 Node Modules (if using frontend dependencies)
node_modules/
