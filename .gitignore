# 🛑 Python Virtual Environment
venv/
.venv/

# Local environment files may contain credentials. Examples stay tracked.
.env
.env.*
!.env.example
!**/.env.example

# 🛑 Compiled Python files
__pycache__/
*.pyc
*.pyo
*.pyd

# 🛑 IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo

# 🛑 Flask & Database
instance/
# The dead root-level migrations/ copy was deleted on 2026-07-29; the live
# Alembic history is and was backend/migrations/. This anchored rule stays so
# the dead copy cannot come back by accident — `flask db init` run from the
# repository root would recreate it, and a second chain that alembic silently
# prefers depending on your working directory is a trap that has already cost
# this project a day and a wrong diagnosis. Note the anchor: a bare
# `migrations/` would match backend/migrations/ too and silently keep every
# real migration out of git.
/migrations/
*.sqlite3
*.db

# 🛑 Log and Cache Files
*.log
*.cache

# 🛑 Node Modules (if using frontend dependencies)
node_modules/

# build output & tooling
app/dist/
code-review/
.superpowers/
